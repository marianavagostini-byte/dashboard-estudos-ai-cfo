{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dashboard-estudos:session:v1",
  "title": "Registro de sessão de estudos v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "date",
    "source",
    "modules",
    "exercises",
    "artifacts",
    "tests",
    "roadmap_updates",
    "next_steps",
    "notes",
    "duration_minutes",
    "git"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "type": "string", "format": "uuid" },
    "date": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "duration_minutes": { "type": ["integer", "null"], "minimum": 0 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topics_studied"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "topics_studied": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["topic", "explained", "practiced"],
              "properties": {
                "topic": { "type": "string", "minLength": 1 },
                "explained": { "type": "boolean" },
                "practiced": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "prompt", "attempted", "resolved", "solution_or_correction", "result"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "attempted": { "type": "boolean" },
          "resolved": { "type": "boolean" },
          "solution_or_correction": { "type": ["string", "null"] },
          "result": { "type": ["string", "null"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result", "details"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "result": { "enum": ["passed", "failed", "not_run"] },
          "details": { "type": "string", "minLength": 1 }
        }
      }
    },
    "roadmap_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "expected_status", "status", "justification", "confirmed_by_user"],
        "properties": {
          "stage_id": { "type": "string", "minLength": 1 },
          "expected_status": {
            "enum": ["Não iniciado", "Em andamento", "Treinando", "Concluído", null]
          },
          "status": { "enum": ["Em andamento", "Treinando", "Concluído"] },
          "justification": { "type": "string", "minLength": 1 },
          "confirmed_by_user": { "const": true }
        }
      }
    },
    "next_steps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit_hash", "push_status", "push_details"],
      "properties": {
        "branch": { "type": ["string", "null"] },
        "commit_hash": { "type": ["string", "null"] },
        "push_status": { "enum": ["not_applicable", "pushed", "blocked"] },
        "push_details": { "type": ["string", "null"] }
      }
    }
  }
}
